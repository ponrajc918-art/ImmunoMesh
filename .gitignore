# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
.env
.env.*

# Logs and OS cruft
*.log
.DS_Store
Thumbs.db
Desktop.ini

# Build artifacts
build/
dist/
*.egg-info/

# Scratch / bulky / risky results — kept OUT of version control
# Pickled detectors can execute code when loaded.
# Large predictions.csv files are excluded.
# Results/run_seed*/metrics.json and config.yaml remain tracked.
results/run_seed*/detector.joblib
results/run_seed*/predictions.csv
results/live/
results/final/demo_check/
results/final/_seeds/.tmp*

# Local HIL SQLite databases — retain them on this computer.
# Reviewed HIL reports, manifests, and CSV summaries remain trackable.
results/hil/*.db

# Final research evidence IS tracked — do not ignore:
# results/final/, results/final/tables/, results/final/figures/,
# results/final/demo/, results/final/run_manifest.json,
# results/final/RESULTS.md, results/final/_seeds/

# Generated by `cli setup` — local deployment config, not a repo artifact
/immunomesh.yaml